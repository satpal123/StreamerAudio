<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Stream Source Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stream Source"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose how to fetch streams"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/streamSourceRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/hlsRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Twitch HLS (Direct)"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:paddingVertical="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Connects directly to Twitch servers"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:paddingStart="32dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp" />

                    <RadioButton
                        android:id="@+id/proxyRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Proxy Servers"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:paddingVertical="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Uses third-party proxy\n• Choose server location below"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:paddingStart="32dp"
                        android:paddingEnd="16dp" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Proxy Server Selection -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proxy Server"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select proxy location (only used when Proxy mode is enabled)"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/proxyRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/proxyEuRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Europe (EU)"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:paddingVertical="8dp" />

                    <RadioButton
                        android:id="@+id/proxyEu2Radio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Europe 2 (EU2)"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:paddingVertical="8dp" />

                    <RadioButton
                        android:id="@+id/proxyEu3Radio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Europe 3 (EU3)"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:paddingVertical="8dp" />

                    <RadioButton
                        android:id="@+id/proxyAsRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Asia (AS)"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:paddingVertical="8dp" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ Info"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Changes take effect the next time you play a stream."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Logout Button -->
        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Logout"
            android:textColor="@android:color/white"
            android:backgroundTint="#E74C3C"
            android:paddingVertical="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>